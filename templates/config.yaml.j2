{{ ansible_managed | comment }}

source_directories:
  {{ borgmatic_source_directories | to_nice_yaml(sort_keys=false) | indent(2) | trim }}

repositories:
  {{ borgmatic_repositories | to_nice_yaml(sort_keys=false,indent=2) | indent(2) | trim }}

exclude_patterns:
  {{ borgmatic_exclude_patterns | to_nice_yaml(sort_keys=false) | indent(2) | trim }}

exclude_caches: {{ borgmatic_exclude_caches | bool }}

encryption_passphrase: {{ borgmatic_encryption_passphrase | to_json }}
{% if borgmatic_keep is defined and borgmatic_keep %}

{% for key, value in borgmatic_keep.items() %}
keep_{{ key }}: {{ value }}
{% endfor %}
{% endif %}

checks:
  {{ borgmatic_checks | to_nice_yaml(sort_keys=false,indent=2) | indent(2) | trim }}
check_last: {{ borgmatic_check_last }}
{% if borgmatic_config_extra is defined and borgmatic_config_extra %}

{{ borgmatic_config_extra | to_nice_yaml(sort_keys=false,indent=2) | trim }}
{% endif %}
